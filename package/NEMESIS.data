[nemesis]
version=1.1
id=smarttube
name=SmartTube
type=application
package-version=@PACKAGE_VERSION@
short-desc=SmartTube for Gen5W head units
depends=media.codecs@>=@CODECS_MIN_VERSION@
os=any
models=any

[app.0]
kind=apk
path=app/SmartTube.apk
package=org.smarttube.stable
