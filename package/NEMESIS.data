[nemesis]
version=1.1
id=smarttube
name=SmartTube
type=application,service
package-version=@PACKAGE_VERSION@
short-desc=SmartTube for Gen5W head units
depends=media.codecs@>=@CODECS_MIN_VERSION@
os=any
models=any
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/SmartTube.apk
package=org.smarttube.stable
component=org.smarttube.stable/com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity

[service.0]
name=netguard
kind=sh
path=svc/netguard.sh
uid=root
mode=restart
