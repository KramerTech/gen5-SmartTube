[nemesis]
version=@VERSION@
id=smarttube
name=SmartTube
types=application,service
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/SmartTube.apk
package=org.smarttube.stable
component=org.smarttube.stable/com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity

[service.0]
name=depwatch
kind=sh
path=svc/depwatch.sh
uid=root
mode=restart
